# RFID Bridge secret configuration
#
# Copy this file to:
#   /etc/rfid_bridge/secrets.env
#
# Required ownership and permissions:
#   root:rfidbridge
#   0640
#
# Never commit real secret values to Git.

DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
ODOO_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY

# Bearer token for the dedicated least-privilege Odoo RFID API user.
# Never commit the real token.
RFID_ODOO_BEARER_TOKEN=REPLACE_WITH_ODOO_RFID_API_BEARER_TOKEN
