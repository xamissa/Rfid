# RFID Bridge non-secret application configuration
#
# Copy this file to:
#   /etc/rfid_bridge/app.env
#
# Required ownership and permissions:
#   root:rfidbridge
#   0640

DJANGO_DEBUG=false

# Comma-separated hostnames and IP addresses allowed to access Django.
# Replace the example values for the target Raspberry Pi.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,rfid-bridge-01,192.168.1.116

DJANGO_TIME_ZONE=Africa/Johannesburg

POSTGRES_DB=rfid_bridge
POSTGRES_USER=rfid_bridge_app
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Safe deployment defaults.
# Do not change these until hardware and Odoo integration tests are approved.
READER_BACKEND=fake
SENDER_BACKEND=disabled
ALLOW_PHYSICAL_READER_CONTACT=false
ALLOW_ODOO_CONTACT=false
