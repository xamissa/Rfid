[Unit]
Description=RFID Bridge Django Web Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=rfidbridge
Group=www-data
SupplementaryGroups=rfidbridge
WorkingDirectory=/opt/rfid_bridge/app

RuntimeDirectory=rfid_bridge
RuntimeDirectoryMode=0750
UMask=0027

Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/rfid_bridge/venv/bin/gunicorn \
    --workers 2 \
    --umask 007 \
    --bind unix:/run/rfid_bridge/web.sock \
    --access-logfile - \
    --error-logfile - \
    --capture-output \
    --timeout 45 \
    config.wsgi:application

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
